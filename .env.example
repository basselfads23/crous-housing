# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Watcher Settings
TARGET_CITY=Marseille
MAX_PRICE=400
COLOCATION_ONLY=false
ENABLE_DAILY_HEARTBEAT=true

# Smart Time Cadence (French Time Zone)
# Automatically adjusts polling cadence based on office hours
ENABLE_SMART_CADENCE=true
PEAK_CHECK_INTERVAL_SECONDS=35      # 08:00 - 18:30 (Business hours)
EVENING_CHECK_INTERVAL_SECONDS=65   # 18:30 - 23:30 (Evening)
NIGHT_CHECK_INTERVAL_SECONDS=240    # 23:30 - 08:00 (Night sleep mode)
CHECK_INTERVAL_SECONDS=45          # Fallback if smart cadence is disabled

# Automated Application (Sniper)
AUTO_APPLY_ENABLED=true
AUTO_APPLY_DRY_RUN=true            # Set to false when ready to live-submit reservations!
AUTO_APPLY_ANY_MAX_PRICE=300       # Auto-apply for any mode (single or colocation) if < 300€
AUTO_APPLY_SINGLE_MAX_PRICE=350    # Auto-apply if individual mode (single) <= 350€
PREFERRED_OCCUPATION_MODE=single   # 'single' or 'sharing' (coloc)
STUDY_LEVEL=4                      # 1: L1, 2: L2, 3: L3, 4: M1 (Master), 5: M2
PURPOSE=studies                    # 'studies' or 'internship'
ALREADY_ACCOMMODATED=false
TAXES_IN_FRANCE=true

# Automated headless login credentials (optional, enables automatic session renewal on VPS)
CROUS_EMAIL=your_email@example.com
CROUS_PASSWORD=your_crous_password

# Optional Proxy (HTTP or SOCKS5) to bypass datacenter IP restrictions / WAF bans
# Example: CROUS_PROXY=http://username:password@proxy-host:port
CROUS_PROXY=
